import std::io::print;
import std::reactive::{ Flow, Signal, SignalCell, Source };

fun arm(on: bool, count: SignalCell<i32>): dyn Flow<i32> {
	count
}

fun main() {
	let flag = Signal::new(true);
	let count = Signal::new(1);
	let picked = flag.switch(|on: bool| arm(on, count)).memo();
	print(i"{picked.get()}");
}

main();
