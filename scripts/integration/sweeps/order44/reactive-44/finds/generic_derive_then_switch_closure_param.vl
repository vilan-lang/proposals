// INFERENCE BUG (A142): in a generic body, `.switch(|inner| inner)` on a
// `derive` pipe whose value type is the caller's abstract `I` types the
// unannotated closure parameter as the impl's own unsubstituted `T` instead of
// `I`: "cannot infer 'U' for this call" + "generic parameter 'T' is missing the
// bound ': Flow<U>'". Annotating `|inner: I|` compiles and prints 3; the same
// chain at concrete types, and `outer.switch(|inner| inner)` over an
// `S: Source<I>` receiver in a generic body, both work.
import std::io::print;
import std::reactive::{ Signal, SignalCell, Source };

fun join<T, U, I: Source<U>, S: Source<T>>(source: S, f: sync |T| I): U {
    source.derive(f).switch(|inner| inner).sample()
}

fun main() {
    print(join(Signal::new(1), |m| Signal::new(m + 2)));
}
