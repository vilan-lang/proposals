// The macro door for `[derive(Store)]` needs a derive on `Address` to add
// projection methods to the LENS of an `Address` - an inherent impl on one
// instantiation of a generic type declared elsewhere (here: std's `SignalCell`).
// Macros see one item at a time (spec/macros.md 10.2), so this is the only place
// the derive can put `.city()`.
import std::reactive::{ Signal, SignalCell, Source };

struct Address {
	city: str,
	zip: str,
}

impl SignalCell<Address> {
	fun city_now(self): str {
		self.get().city
	}
}

impl List<Address> {
	fun cities(self): List<str> {
		mut out: List<str> = [];
		for a in self {
			out.push(a.city);
		}
		out
	}
}

fun main() {
	let cell: SignalCell<Address> = Signal::new(Address { city = "Oslo", zip = "0150" });
	print(cell.city_now());
	let xs: List<Address> = [Address { city = "Bergen", zip = "5003" }];
	print(xs.cities()[0]);
}
