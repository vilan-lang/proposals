import std::io::print;
import std::shared::Shared;
import std::option::Option::{ self, None, Some };

struct S { n: i32, xs: List<i32>, o: Option<i32> }

fun main() {
	let s = Shared::new(S { n = 1, xs = [], o = None });
	let n = s.read().n + 1;
	s.write().n = n;
	s.write().xs.push(3);
	print(s.read().n);
	print(s.read().xs.len());
}
