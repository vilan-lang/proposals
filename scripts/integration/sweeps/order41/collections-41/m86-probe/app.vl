import std::io::print;
import std::reactive::{ ListCell, SequenceCell, Signal, SignalCell, Source, map_each };
import std::ui::{ View, each, each_by, mount_root, view };

[derive(PartialEq, Hashable)]
struct Row {
	id: i32,
	text: str,
}

fun row(id: i32, text: str): Row {
	Row { id = id, text = text }
}

fun seed(): List<Row> {
	mut many: List<Row> = [];
	mut index = 0;
	for index < 1000 {
		many.push(row(index, "r"));
		index += 1;
	}
	many
}

fun main() {
	let variant = param("variant");
	let pushes = param("pushes");
	mut index = 0;
	if variant == 0 {
		// ListCell, no consumer: the WRITE alone.
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		for index < pushes {
			cell.push(row(1000 + index, "n"));
			index += 1;
		}
	} else if variant == 1 {
		// ListCell + each (the op path).
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		let _root = mount_root("app", || view("ol").child(each(cell, |item: Row| item.id, |item: Row| view("li").text(item.text))));
		for index < pushes {
			cell.push(row(1000 + index, "n"));
			index += 1;
		}
	} else if variant == 2 {
		// ListCell + one no-op subscriber.
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		let _sub = cell.on_change(|_list| {});
		for index < pushes {
			cell.push(row(1000 + index, "n"));
			index += 1;
		}
	} else if variant == 3 {
		// A bare SignalCell update, no subscriber.
		let cell: SignalCell<List<Row>> = Signal::new(seed());
		for index < pushes {
			cell.update(|&mut list| { list.push(row(1000 + index, "n")); });
			index += 1;
		}
	} else if variant == 4 {
		// SignalCell + each (the pass).
		let cell: SignalCell<List<Row>> = Signal::new(seed());
		let _root = mount_root("app", || view("ol").child(each(cell, |item: Row| item.id, |item: Row| view("li").text(item.text))));
		for index < pushes {
			cell.update(|&mut list| { list.push(row(1000 + index, "n")); });
			index += 1;
		}
	} else if variant == 5 {
		// ListCell + each_by.
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		let _root = mount_root("app", || view("ol").child(each_by(cell, |item: Row| item.id, |item: SignalCell<Row>| view("li").bind_text(item.map(|r: Row| r.text)))));
		for index < pushes {
			cell.push(row(1000 + index, "n"));
			index += 1;
		}
	} else if variant == 6 {
		// ListCell + map_each (no each).
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		let _mapped = map_each(cell, |item: Row| item.id);
		for index < pushes {
			cell.push(row(1000 + index, "n"));
			index += 1;
		}
	} else if variant == 7 {
		// ListCell: size() alone (the read the write makes).
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		mut total = 0;
		for index < pushes {
			total += cell.size();
			index += 1;
		}
		print(i"{total}");
	} else if variant == 8 {
		// ListCell + each + a set_at per turn.
		let cell: ListCell<Row> = ListCell<Row>::of(seed());
		let _root = mount_root("app", || view("ol").child(each(cell, |item: Row| item.id, |item: Row| view("li").text(item.text))));
		for index < pushes {
			cell.set_at(500, row(500, i"s{index}"));
			index += 1;
		}
	}
	print(i"variant={variant} pushes={pushes} done");
}

[extern("__param")]
external fun param(name: str): i32;

main();
