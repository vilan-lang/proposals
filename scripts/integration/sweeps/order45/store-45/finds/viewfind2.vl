import std::compare::PartialEq;

trait Same {
	fun same(&self, other: &Self): bool;
}

impl type T: PartialEq with Same {
	fun same(&self, other: &T): bool {
		*self == *other
	}
}

fun generic<T: Same>(a: T, b: T): bool {
	a.same(&b)
}

fun main() {
	let a = 1;
	let b = 1;
	print(a.same(&b));
	print(generic(a, b));
}
