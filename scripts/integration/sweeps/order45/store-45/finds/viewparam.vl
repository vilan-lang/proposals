import std::shared::Shared;

fun main() {
	let cell = Shared::new(1);
	let lend = |f: |&i32| void| f(&cell.write());
	let modify = |f: |&mut i32| void| f(&mut cell.write());
	lend(|held: &i32| print(*held));
	modify(|place: &mut i32| {
		place = 5;
	});
	lend(|held: &i32| print(*held));
	let s = Shared::new("ab");
	let lend_s = |f: |&str| void| f(&s.write());
}
