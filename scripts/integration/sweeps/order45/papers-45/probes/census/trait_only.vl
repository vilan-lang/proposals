// B485 §3 (the proviso): `[trait_only]` hides a trait method from the concrete
// type's own surface. A concrete call is refused (loud); a call through the
// bound reaches it. Zero sites use it in std, examples or kolt.
trait Named { [trait_only] fun name(self): str; }
struct S { a: i32 }
impl S with Named { fun name(self): str { "S" } }
fun through_bound<T: Named>(t: T): str { t.name() }
fun main() {
	let s = S { a = 1 };
	print(through_bound(s));
	print(s.name());
}
