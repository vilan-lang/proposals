// B460 opacity, probe 7b: o7 without the deliberate error, for both backends.
import std::reactive::{ Source, SignalCell, Flow, Pipe };

struct Model { count: SignalCell<i32> }

impl Model {
	fun doubled_label(self): Pipe<str> {
		self.count.derive(|x| x * 2).distinct().derive(|x| i"{x}")
	}
}

fun main() {
	let m = Model { count = SignalCell::new(2) };
	let shown = m.doubled_label().memo();
	print(shown.get());
	m.count.set(5);
	print(shown.get());
	let p = m.doubled_label();
	let q = p;               // a pipe node is [resource]: the move is tracked on the concrete type
	print(q.sample());
}
