+
+/// What a CONSUMER asks a source for when it can use ops but does not require
+/// them: a delta feed, or nothing (A112 S3).
+///
+/// `each` takes any `Source<List<T>>` and must go on doing so, so it cannot
+/// bound on `DeltaSource` — and vilan has no overloading, so the choice cannot
+/// be two functions of one name either. It is one trait with a BLANKET impl
+/// answering "no feed", which every source satisfies, and a per-cell impl
+/// answering a real one; the specificity order picks the cell's (`spec/types.md`
+/// §5.4: a constructor-headed impl outranks a blanket).
+///
+/// **A cell with a log gets one line.** The blanket's three bodies are the
+/// no-feed answer, and an impl over a cell forwards to its `DeltaSource`
+/// members. What the extra trait buys over bounding on `DeltaSource` directly is
+/// that a consumer may be written ONCE for both kinds of source.
+///
+/// It is a separate trait rather than three defaults on `Source<T>` because
+/// `Source`'s argument is the whole value and these are about a COLLECTION's
+/// element type — a `Source<i32>` has no `SeqOp<i32>` feed to offer, and giving
+/// it one would put a collection's vocabulary on every signal in the language.
+export trait DeltaFeed<T> with Source<List<T>> {
+	/// A cursor into this source's op log, or `None` when it keeps none.
+	fun delta_cursor(self): Option<DeltaCursor>;
+
+	/// Everything the cursor has not been told. A source that answered `None`
+	/// above is never asked.
+	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>>;
+
+	/// Retire the cursor, so a disposed consumer stops pinning history.
+	fun drop_delta_cursor(self, cursor: DeltaCursor);
+}
+
+/// Every collection source, including every plain `SignalCell<List<T>>`: no
+/// log, so no feed, so the consumer keeps its whole-value path. This is what
+/// "a `SignalCell` is not a delta source" means in code.
+export impl type S: Source<List<type T>> with DeltaFeed<T> {
+	fun delta_cursor(self): Option<DeltaCursor> {
+		None
+	}
+
+	fun delta_since(self, cursor: DeltaCursor): List<SeqOp<T>> {
+		mut none: List<SeqOp<T>> = [];
+		none
+	}
+
+	fun drop_delta_cursor(self, cursor: DeltaCursor) {}
+}
