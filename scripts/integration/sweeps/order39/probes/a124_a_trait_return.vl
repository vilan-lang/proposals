// (a) a trait REQUIREMENT whose return is the bare trait; impls return concrete nodes
trait Src<T> {
	fun get(self): T;
	fun dbl(self): Src<T>;
}
struct Root { v: i32 }
struct Dbl<S> { up: S }
impl Root with Src<i32> {
	fun get(self): i32 { self.v }
	fun dbl(self): Dbl<Root> { Dbl<Root> { up = self } }
}
impl Dbl<type S: Src<i32>> with Src<i32> {
	fun get(self): i32 { self.up.get() * 2 }
	fun dbl(self): Dbl<Dbl<S>> { Dbl<Dbl<S>> { up = self } }
}
fun main() {
	let r = Root { v = 3 };
	let d = r.dbl().dbl();
	print(i"{d.get()}");
}
