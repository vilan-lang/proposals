trait Src<T> { fun get(self): T; }
struct Root { v: i32 }
impl Root with Src<i32> { fun get(self): i32 { self.v } }
impl type S: Src<type T> { fun twice(self): (T, T) { (self.get(), self.get()) } }
fun through(s: Src<i32>): i32 { let (a, b) = s.twice(); a + b }
fun main() { print(through(Root { v = 5 })); }
