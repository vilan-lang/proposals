import std::wire::{ Wire, Serialize, Deserialize, Serializer, Deserializer };
impl Instant with Wire {
	fun describe<S: Serialize>(self, serializer: &mut S) {
		serializer.begin_struct(1);
		serializer.field("millis");
		self.millis.describe(serializer);
		serializer.end_struct();
	}
	fun rebuild<D: Deserialize>(deserializer: &mut D): Instant {
		deserializer.begin_struct();
		deserializer.field("millis");
		let millis = i53::rebuild(deserializer);
		deserializer.end_struct();
		Instant { millis = millis }
	}
}

