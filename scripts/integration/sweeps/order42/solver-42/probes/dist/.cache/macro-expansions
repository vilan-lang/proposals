import std::compare::PartialEq;
impl DraftState with PartialEq {
	fun eq(self, other: DraftState): bool {
		match (self, other) {
			(DraftState::Synced, DraftState::Synced) => true,
			(DraftState::Dirty, DraftState::Dirty) => true,
			(DraftState::Failed(let s0), DraftState::Failed(let o0)) => s0 == o0,
			_ => false,
		}
	}
}

