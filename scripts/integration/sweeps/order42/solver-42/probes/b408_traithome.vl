trait Src<T> { fun get(self): T; }
trait Doubler { fun doubled(self): i32; }
struct Root { v: i32 }
impl Root with Src<i32> { fun get(self): i32 { self.v } }
impl type S: Src<i32> with Doubler { fun doubled(self): i32 { self.get() * 2 } }
fun through<S: Src<i32>>(s: S): i32 { s.doubled() }
fun main() { print(through(Root { v = 21 })); }
