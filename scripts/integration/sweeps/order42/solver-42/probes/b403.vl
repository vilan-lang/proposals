trait Label { fun label(): str; }
struct A {}
impl A with Label { fun label(): str { "A" } }
struct B {}
impl B with Label { fun label(): str { "B" } }
struct Holder<T> { v: T }
impl Holder<type T: Label> {
	fun tag(): str { T::label() }
	fun show(self): str { Holder::tag() }
	fun show_self(self): str { Self::tag() }
	fun show_named(self): str { Holder<T>::tag() }
}
fun main() {
	print(Holder { v = A {} }.show_self());
	print(Holder { v = B {} }.show_named());
	print(Holder { v = A {} }.show());
	print(Holder { v = B {} }.show());
}
