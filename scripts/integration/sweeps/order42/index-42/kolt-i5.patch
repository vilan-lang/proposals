@@ -52,8 +52,12 @@
 
 	fun focus(self, key: i32, offset: i32) {
 		let nodes = self.nodes.read();
-		let index = (key + offset) % nodes.len();
-		let index = if index < 0 { nodes.len() + index } else { index };
+		// `Map::len()` answers a `usize` (an index); the wrap below is signed
+		// arithmetic on purpose (`offset` is -1 or +1), so the count converts
+		// once into it and the keys stay `i32`.
+		let count = nodes.len().as_i32();
+		let index = (key + offset) % count;
+		let index = if index < 0 { count + index } else { index };
 		if nodes.get(index) is Some(let element) {
 			element.focus();
 		}
