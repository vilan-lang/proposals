+/// E318: what [`Analyzer::emitter_plans`] settles — the emitter-only tables
+/// of the extraction tail, each empty when the analysis skipped them.
+#[derive(Default)]
+struct EmitterPlans {
+    held_live: held_tables::HeldRows,
+    resource_types: HashSet<TypeId>,
+    clone_sites: HashMap<Id, CopyDecision>,
+    return_clone_sites: HashMap<Id, CopyDecision>,
+    return_view_reads: HashSet<Id>,
+    parameter_entry_clones: HashSet<Id>,
+    capture_plan: CapturePlan,
+    receiver_views: HashSet<Id>,
