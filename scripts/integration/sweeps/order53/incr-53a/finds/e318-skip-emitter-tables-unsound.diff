+    /// E318: the EMITTER-ONLY tail of `analyze_over_world` — the last-use
+    /// dataflow and every plan that reads it (the drop extents, the held
+    /// passes, the clone decisions, the resource types, the return, view and
+    /// boxing plans, the HMR classification). Every output is read by the
+    /// emitters and by nothing else: no diagnostic, no post pass and no editor
+    /// table depends on one, which is what lets a front end that never emits
+    /// skip the call (`Workspace::skip_emitter_tables`).
+    fn emitter_plans(&mut self, global_scope_id: Id) -> EmitterPlans {
+    self.clear_view_memos();
+    self.last_use = liveness::LastUse::compute(self);
+    crate::phase_pass_mark("liveness::LastUse::compute");
+    // S3 (`lifetimes.md` §6): the same answers, asked for DISPOSAL — where each
+    // enrolled binding's teardown `finally` closes. Must follow the dataflow;
+    // `plan_resource_drops` (which bindings drop) ran long before it.
+    self.plan_last_use_drop_extents();
+    crate::phase_pass_mark("analyzer.plan_last_use_drop_extents()");
+    // M110 S7b: the five held passes below read whole-program inputs — the
+    // written roots, the `Shared` cells, the value seams, their candidates
+    // — folded from the live regions' contributions (one walk) and the
+    // restored regions' rows (`held_tables.rs`); each decision below is then
+    // taken over every candidate, so no output row is ever served.
+    let held_live = self.collect_held_rows();
+    crate::phase_pass_mark("analyzer.collect_held_rows()");
+    let mut held = self.fold_held(&held_live);
+    // B267: the cell-aware half of rule 2, which needs the dataflow above and
+    // feeds every elision below — a binding it admits copies nothing at its
+    // read and may donate nothing at its own.
+    self.shared_cells = std::mem::take(&mut held.cells);
+    crate::phase_pass_mark("the held fold");
+    // M96/B457: every call of the program indexed by span, on first ask —
+    // the call-through tests of the shared reads and the clone sites.
+    let calls_index: std::cell::OnceCell<LexicalCandidates> = std::cell::OnceCell::new();
+    (self.shared_read_bindings, self.elided_shared_reads) =
+        self.compute_shared_read_bindings(&held, &calls_index);
+    crate::phase_pass_mark("analyzer.compute_shared_read_bindings()");
+    // M90: before the capture plan, whose move elision must refuse to move out
+    // of a shared `let` exactly as rule 2 below does.
+    (self.shared_place_lets, self.shared_place_inits) =
+        self.compute_shared_place_lets(&held);
+    crate::phase_pass_mark("analyzer.compute_shared_place_lets()");
+    // B53: the capture pass runs FIRST — its share elision decides which
+    // captures own nothing, and rule 2's move elision (inside
+    // `compute_clone_sites`) must refuse to move out of those.
+    let capture_plan = self.compute_capture_clone_sites(&held);
+    crate::phase_pass_mark("analyzer.compute_capture_clone_sites()");
+    let resource_types = self.compute_resource_types();
+    crate::phase_pass_mark("analyzer.compute_resource_types()");
+    let clone_sites = self.compute_clone_sites(&capture_plan.shared, &calls_index);
+    crate::phase_pass_mark("analyzer.compute_clone_sites()");
+    let (return_clone_sites, return_view_reads) = self.compute_return_clone_sites();
+    crate::phase_pass_mark("analyzer.compute_return_clone_sites()");
+    let parameter_entry_clones = self.compute_parameter_entry_clones();
+    let receiver_views = self.compute_receiver_views();
+    let fixed_view_refs = self.compute_fixed_view_refs();
+    let transient_view_payloads = self.compute_transient_view_payloads();
+    let payload_view_captures: HashMap<Id, bool> =
+        self.payload_view_capture_modes().into_iter().collect();
+    let (boxed_locals, generic_referenced_roots) = self.compute_boxed_locals(&receiver_views);
+    let primitive_views = self.compute_primitive_views();
+    let scalar_view_refs = self.compute_scalar_view_refs();
+    let scalar_view_calls = self.compute_scalar_view_calls();
+
+    // The HMR transfer classification (`hmr.md` §4), computed while the analyzer
+    // still holds the type tables and the resource classifier. Computed for every
+    // emitting analysis (a cheap type-level pass over the entry's module-level
+    // bindings); the transformer
+    // consults it only under `BuildOptions.hmr`, so non-HMR output is unaffected.
+    let hmr_bindings = self.compute_hmr_bindings(global_scope_id);
+    crate::phase_pass_mark("the view, clone and hmr plans");
+        EmitterPlans {
+            held_live,
+            resource_types,
+            clone_sites,
+            return_clone_sites,
+            return_view_reads,
+            parameter_entry_clones,
+            capture_plan,
+            receiver_views,
+            fixed_view_refs,
+            transient_view_payloads,
+            payload_view_captures,
+            boxed_locals,
+            generic_referenced_roots,
+            primitive_views,
+            scalar_view_refs,
+            scalar_view_calls,
+            hmr_bindings,
+        }
+    }
+}
