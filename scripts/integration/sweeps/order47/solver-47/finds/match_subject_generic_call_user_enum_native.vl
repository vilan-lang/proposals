// FIND (solver-47): natively refused "an unbound generic type parameter (parameter 1 of `wrap`)".
// The same with `let r = wrap(3); match r { .. }` runs; with std Option instead of a user enum it runs.
// JS prints 3. Base e5e15ca7.
enum Maybe<T> { Nothing, Just(T) }
fun wrap<T>(item: T): Maybe<T> { Maybe::Just(item) }
fun main() {
    match wrap(3) {
        Maybe::Just(let v) => print(v),
        Maybe::Nothing => print("none"),
    }
}
