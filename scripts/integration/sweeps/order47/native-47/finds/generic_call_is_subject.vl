// native: a GENERIC call as an `if .. is` subject is refused ("an unbound generic
// type parameter (parameter 1 of `wrap`)"); the same call as a `match` subject,
// or bound to a `let` first, builds. JS prints "deep" then 3.
import std::io::print;

enum Maybe<T> {
	Just(T),
	Nothing,
}

fun wrap<T>(value: T): Maybe<T> {
	Maybe::Just(value)
}

fun main() {
	if wrap("deep") is Maybe::Just(let s) {
		print(s);
	}
	match wrap(3) {
		Maybe::Just(let n) => print(n),
		Maybe::Nothing => print("-"),
	}
}

main();
