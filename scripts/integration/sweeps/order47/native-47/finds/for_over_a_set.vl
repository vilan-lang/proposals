// native: `for value in set` over a `HashSet` (an `Iterator` impl) is refused by name;
// for-mut-container.vl is the user-iterator twin (`for e in &mut c` over a `next_mut`).
// JS prints 4.
import std::hash_set::HashSet;
import std::io::print;

fun main() {
	mut numbers: HashSet<i32> = HashSet::new();
	numbers.insert(1);
	numbers.insert(3);
	mut total = 0;
	for value in numbers {
		total = total + value;
	}
	print(total);
}

main();
