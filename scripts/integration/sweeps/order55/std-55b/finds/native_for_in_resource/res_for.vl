import std::drop::Drop;
import std::io::print;
import std::option::Option::{ self, None, Some };
import std::shared::Shared;
import std::time::sleep;

[resource]
struct Ticks {
	left: Shared<i32>,
}

fun open(): Ticks {
	print("raw on");
	Ticks { left = Shared::new(5) }
}

impl Ticks {
	fun next(self): Option<i32> {
		sleep(5);
		let left = self.left.read();
		if left == 0 {
			None
		} else {
			self.left.write() = left - 1;
			Some(left)
		}
	}
}

impl Ticks with Drop {
	fun drop(&mut self) {
		print("raw off");
	}
}

fun main() {
	let ticks = open();
	for tick in ticks {
		print(i"tick {tick}");
		if tick == 3 {
			jump break;
		}
	}
	print("after loop");
	let more = open();
	for tick in more {
		print(i"tick {tick}");
	}
	print("done");
}
