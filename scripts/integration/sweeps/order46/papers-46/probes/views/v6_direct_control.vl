// B495 probe v6 (control): the same closure literal handed DIRECTLY to a
// position whose closure type is written there — adoption works there.
import std::io::print;

fun apply(f: |&mut i32| void, n: &mut i32) {
	f(n);
}

fun main() {
	mut n = 1;
	apply(|x| {
		x += 10;
	}, &mut n);
	print(i"handed to a fun parameter: n={n}");
	let spelled: |&mut i32| void = |x: &mut i32| {
		x += 100;
	};
	spelled(&mut n);
	print(i"annotated let, literal SPELLS the view: n={n}");
}
