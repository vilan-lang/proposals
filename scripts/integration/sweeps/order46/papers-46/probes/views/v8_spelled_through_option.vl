// B495 probe v8: F69's shapes with the view SPELLED on the literal — no adoption
// needed; the CALL through the capture / loop binding must still pass a place.
import std::io::print;

struct Counter {
	n: i32,
}

fun main() {
	mut c = Counter { n = 1 };
	let bump: Option<|&mut i32| void> = Some(|x: &mut i32| {
		x += 10;
	});
	match bump {
		Some(let f) => f(&mut c.n),
		None => {},
	}
	print(i"through a match capture: n={c.n}");
	let all: List<|&mut i32| void> = [|x: &mut i32| {
		x += 100;
	}];
	for g in all {
		g(&mut c.n);
	}
	print(i"through a loop binding: n={c.n}");
}
