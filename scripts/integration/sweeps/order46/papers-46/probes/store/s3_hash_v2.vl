// A153 probe s3 (v2): Message gains `edited: bool`.
// differ only in `Message` (v2 adds `edited: bool`). Prints both services' hash.
import std::io::print;
import std::reactive::{ Signal, SignalCell };

[derive(Wire)]
struct Message {
	id: u53,
	content: str,
	edited: bool,
}

[service(SvcClient)]
struct Svc {
	last: SignalCell<Option<Message>>,
}

impl Svc {
	[rpc]
	fun message(self, id: u53): SignalCell<Option<Message>> {
		self.last
	}
}

fun main() {
	let svc = Svc { last = Signal::new(None) };
	print(i"v2 contract_hash={svc.contract_hash()}");
}
