// B509 probe b6: what the copy-out-and-back costs on JS. A payload holding a
// 10,000-element list; 2,000 writes of one scalar field, (a) through the
// variant by take/put-back (the store's `Option` write), (b) on the same struct
// held directly (no variant: an in-place field write).
import std::io::print;
import std::option::Option::{ self, None, Some };
import std::time::now_millis;

struct P {
	x: i32,
	big: List<i32>,
}

fun payload(): P {
	mut big: List<i32> = [];
	mut i = 0;
	for i < 10000 {
		big.push(i);
		i += 1;
	}
	P { x = 0, big }
}

fun main() {
	mut held: Option<P> = Some(payload());
	let t0 = now_millis();
	mut n = 0;
	for n < 2000 {
		match held.take() {
			Some(mut p) => {
				p.x += 1;
				held = Some(p);
			},
			None => {},
		}
		n += 1;
	}
	let t1 = now_millis();
	mut direct = payload();
	n = 0;
	for n < 2000 {
		direct.x += 1;
		n += 1;
	}
	let t2 = now_millis();
	print(i"(a) take/put-back: {t1 - t0} ms  x={held.map(|p| p.x).unwrap_or(0)}");
	print(i"(b) direct field:  {t2 - t1} ms  x={direct.x}");
}
