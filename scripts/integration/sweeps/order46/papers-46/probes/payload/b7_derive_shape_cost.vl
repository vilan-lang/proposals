// B509 probe b7: the `[derive(Storable)]` enum write step's shape (store.vl,
// `store_enum_impls`): `match held { E::A(mut p0) => { f(&mut p0); held =
// E::A(p0); } }` with `held: &mut E` — the capture is a COPY, written back whole.
// 2,000 writes of one scalar inside a payload holding a 10,000-element list,
// against the same write on the struct held directly.
import std::io::print;
import std::time::now_millis;

struct P {
	x: i32,
	big: List<i32>,
}

enum E {
	A(P),
	B,
}

fun payload(): P {
	mut big: List<i32> = [];
	mut i = 0;
	for i < 10000 {
		big.push(i);
		i += 1;
	}
	P { x = 0, big }
}

fun through_variant(held: &mut E, f: |&mut P| void) {
	match held {
		E::A(mut p0) => {
			f(&mut p0);
			held = E::A(p0);
		},
		_ => {},
	}
}

fun direct(held: &mut P, f: |&mut P| void) {
	f(held);
}

fun main() {
	mut e = E::A(payload());
	let t0 = now_millis();
	mut n = 0;
	for n < 2000 {
		through_variant(&mut e, |p: &mut P| {
			p.x += 1;
		});
		n += 1;
	}
	let t1 = now_millis();
	mut s = payload();
	n = 0;
	for n < 2000 {
		direct(&mut s, |p: &mut P| {
			p.x += 1;
		});
		n += 1;
	}
	let t2 = now_millis();
	let x = match e {
		E::A(let p) => p.x,
		E::B => 0,
	};
	print(i"(a) derive's through-variant write: {t1 - t0} ms  x={x}");
	print(i"(b) direct, through a &mut lend:   {t2 - t1} ms  x={s.x}");
}
