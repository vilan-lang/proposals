// B509 probe b2: matching a `&mut` REFERENCE to the place — does the capture
// become a writable view into the payload?
import std::io::print;
import std::option::Option::{ self, None, Some };

struct P {
	x: i32,
}

fun main() {
	mut held: Option<P> = Some(P { x = 1 });
	match &mut held {
		Some(let p) => {
			p.x = 2;
		},
		None => {},
	}
	print(i"match &mut held, Some(let p), p.x = 2: held.x={held.map(|p| p.x).unwrap_or(0)}");
}
