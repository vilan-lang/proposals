// B509 probe b12: the subject is ITSELF a `&mut` parameter (store.vl's write step
// is this shape). (1) `match held { Some(let p) => p.x = .. }`; (2) the same with
// the subject spelled `&mut held`.
import std::io::print;
import std::option::Option::{ self, None, Some };

struct P {
	x: i32,
}

fun one(held: &mut Option<P>) {
	match held {
		Some(let p) => {
			p.x = 2;
		},
		None => {},
	}
}

fun main() {
	mut held: Option<P> = Some(P { x = 1 });
	one(&mut held);
	print(i"x={held.map(|p| p.x).unwrap_or(0)}");
}
