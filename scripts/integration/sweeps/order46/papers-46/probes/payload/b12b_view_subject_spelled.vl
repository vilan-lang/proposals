// B509 probe b12b: b12 with the subject spelled `&mut held`.
import std::io::print;
import std::option::Option::{ self, None, Some };

struct P {
	x: i32,
}

fun two(held: &mut Option<P>) {
	match &mut held {
		Some(let p) => {
			print(i"read p.x={p.x}");
		},
		None => {},
	}
}

fun main() {
	mut held: Option<P> = Some(P { x = 1 });
	two(&mut held);
}
