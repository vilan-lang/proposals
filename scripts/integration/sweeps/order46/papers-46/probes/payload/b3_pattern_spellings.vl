// B509 probe b3: candidate pattern spellings, as the 0.43.0 parser reads them.
import std::io::print;
import std::option::Option::{ self, None, Some };

struct P {
	x: i32,
}

fun main() {
	mut held: Option<P> = Some(P { x = 1 });
	match held {
		Some(&mut p) => {
			p.x = 2;
		},
		None => {},
	}
	print(i"held.x={held.map(|p| p.x).unwrap_or(0)}");
}
