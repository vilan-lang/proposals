-// A mirror's state as a LEASED pipe. `mirror.state()` only REPORTS (std's
-// documented contract: it leases nothing, so an unwatched mirror stays
-// `Pending` forever), and `mirror.latest()` leases but keeps only the value.
-// This is `latest()`'s own shape - the mirror as a source (its lease) combined
-// with what the last mint said - re-read as the whole state, `Absent` and
-// `Failed` included.
-fun transient_of<T>(mirror: RemoteSource<T>): dyn Flow<TransientState<T, RpcError>> {
-	let leased: dyn Source<Option<T>> = mirror;
-	let told: dyn Source<Status> = mirror.status();
-	let state: dyn Flow<TransientState<T, RpcError>> = combine((leased, told))
-		.derive(|_both| mirror.transient_state());
-	state
-}
-
-// `TransientState::map`: the same state over `transform(value)`, the stale
-// value of a `Refreshing` or a `Failed` included.
-fun map_state<T, U>(
-	state: TransientState<T, RpcError>,
-	transform: |T| U,
-): TransientState<U, RpcError> {
-	match state {
-		TransientState::Pending => TransientState::Pending,
-		TransientState::Ready(let v) => TransientState::Ready(transform(v)),
-		TransientState::Refreshing(let v) => TransientState::Refreshing(transform(v)),
-		TransientState::Failed(let e, let v) => TransientState::Failed(e, v.map(transform)),
-		TransientState::Absent => TransientState::Absent,
-	}
-}
