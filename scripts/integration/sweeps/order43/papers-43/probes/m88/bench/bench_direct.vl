import std::io::print;

trait Step {
	fun step(self, x: i32): i32;
}
struct Add { k: i32 }
impl Add with Step { fun step(self, x: i32): i32 { (x + self.k) % 1000003 } }

struct Holder { s: Add }

fun main() {
	mut total = 0;
	mut i = 0;
	for i < 20000000 {
		let h = Holder { s = Add { k = i % 7 } };
		total = h.s.step(total);
		i += 1;
	}
	print(total);
}
