trait Src {
	fun get(self): i32;
}
struct Root {
	n: i32,
}
impl Root with Src {
	fun get(self): i32 {
		self.n
	}
}
[derive(PartialEq)]
struct Holder {
	s: dyn Src,
}
fun main() {
	let a: dyn Src = Root { n = 5 };
	let b: dyn Src = Root { n = 5 };
	print(Holder { s = a } == Holder { s = b });
	print(Holder { s = a } == Holder { s = a });
}
