trait Total {
	fun total(self): i32;
}

impl [i32; 2] with Total {
	fun total(self): i32 {
		self[0] + self[1]
	}
}

impl [i32; 3] with Total {
	fun total(self): i32 {
		self[0] + self[1] + self[2]
	}
}

fun main() {
	let a: [i32; 2] = [1, 2];
	let b: [i32; 3] = [1, 2, 3];
	print(a.total());
	print(b.total());
}
