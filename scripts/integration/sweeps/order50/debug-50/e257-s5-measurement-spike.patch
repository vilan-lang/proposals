+/// SPIKE (E257 S5 measurement): strips the marker characters, computing a
+/// generated line:col per marker and the size of the v3 `mappings` string a
+/// writer would emit (VLQ, four fields per segment, source deltas faked small).
+fn spike_strip_marks(output: String) -> String {
+    const B64: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    fn vlq(out: &mut String, value: i64) {
+        let mut v = if value < 0 { ((-value) << 1) | 1 } else { value << 1 };
+        loop {
+            let mut digit = (v & 31) as usize;
+            v >>= 5;
+            if v > 0 {
+                digit |= 32;
+            }
+            out.push(B64[digit] as char);
+            if v == 0 {
+                break;
+            }
+        }
+    }
+    let mut clean = String::with_capacity(output.len());
+    let mut mappings = String::new();
+    let (mut line, mut column) = (0usize, 0usize);
+    let (mut last_line_column, mut last_line) = (0i64, 0usize);
+    let (mut src_line, mut src_col) = (0i64, 0i64);
+    let mut count = 0usize;
+    let mut tick = 7u32;
+    for character in output.chars() {
+        match character {
+            '\u{E000}' => {
+                count += 1;
+                if line != last_line {
+                    for _ in last_line..line {
+                        mappings.push(';');
+                    }
+                    last_line = line;
+                    last_line_column = 0;
+                } else if count > 1 {
+                    mappings.push(',');
+                }
+                vlq(&mut mappings, column as i64 - last_line_column);
+                last_line_column = column as i64;
+                vlq(&mut mappings, 0);
+                tick = tick.wrapping_mul(1103515245).wrapping_add(12345);
+                let dl = ((tick >> 16) % 4) as i64 - 1;
+                let dc = ((tick >> 20) % 24) as i64 - 8;
+                src_line += dl;
+                src_col += dc;
+                vlq(&mut mappings, dl);
+                vlq(&mut mappings, dc);
+            }
+            '\n' => {
+                line += 1;
+                column = 0;
+                clean.push(character);
+            }
+            _ => {
+                column += 1;
+                clean.push(character);
+            }
+        }
+    }
+    let _ = (src_line, src_col);
+    eprintln!(
+        "SPIKE marks={count} output_bytes={} mappings_bytes={}",
+        clean.len(),
+        mappings.len()
+    );
+    clean
+}
