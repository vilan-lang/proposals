// An `[rpc]` parameter of fixed-array type is refused twice for one cause, and
// the second refusal names the type `_`:
//   "in code generated by this attribute: [u8; 4] has no method 'describe'"
//   "parameter `rgba` of `[rpc]` method `first` is `_`, which is not Wire: ..."
// Expected: one refusal naming `[u8; 4]` (a fixed array is not Wire today).
import std::io::print;

[service(PixelClient)]
struct Pixels {
	unused: i32,
}

impl Pixels {
	[rpc]
	fun first(self, rgba: [u8; 4]): u8 {
		rgba[0]
	}
}

fun main() {
	print(Pixels { unused = 0 }.contract_hash());
}

main();
