// A173 ground truth: the shape that DOES work today - an inherent awaiting
// `next(self): Option<T>` on a handle with its cursor in a `Shared`, pulled by
// a bare `for { .. }` loop (Watcher's and Reader's shape), and the same loop
// inside a nursery that cancels it.
import std::io::print;
import std::option::Option::{ self, None, Some };
import std::shared::Shared;
import std::task;
import std::time;

struct Ticks {
    left: Shared<i32>,
}

impl Ticks {
    fun next(self): Option<i32> {
        if self.left.read() == 0 {
            ret None;
        }
        time::sleep(5);
        self.left.write() = self.left.read() - 1;
        Some(self.left.read())
    }
}

fun main() {
    let ticks = Ticks { left = Shared::new(3) };
    for {
        match ticks.next() {
            Some(let tick) => print(i"tick {tick}"),
            None => jump break,
        }
    }
    print("drained");
    let forever = Ticks { left = Shared::new(1000000) };
    task::nursery(|n| {
        async {
            for {
                match forever.next() {
                    Some(let tick) => {}
                    None => jump break,
                }
            }
        };
        time::sleep(20);
        n.cancel();
    });
    print("cancelled and joined");
}
