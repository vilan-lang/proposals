// A173 ground truth: a `for x in subject` over a type with an INHERENT
// awaiting `next(self): Option<T>` (no trait; cursor in a `Shared`) - does the
// iteration protocol accept a by-value receiver, and does the loop await?
import std::io::print;
import std::option::Option::{ self, None, Some };
import std::shared::Shared;
import std::time;

struct Ticks {
    left: Shared<i32>,
}

impl Ticks {
    fun next(self): Option<i32> {
        if self.left.read() == 0 {
            ret None;
        }
        time::sleep(5);
        self.left.write() = self.left.read() - 1;
        Some(self.left.read())
    }
}

fun main() {
    let ticks = Ticks { left = Shared::new(3) };
    for tick in ticks {
        print(i"tick {tick}");
    }
    print("done");
}
