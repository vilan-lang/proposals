+/// The strings one edit from `word`: a letter dropped, two swapped, one
+/// changed, one added.
+fun edits(word: str): HashSet<str> {
+	let letters = "abcdefghijklmnopqrstuvwxyz'";
+	mut out: HashSet<str> = HashSet::new();
+	let n = word.len();
+	mut i = 0usize;
+	for i <= n {
+		let a = word.substring(0, i);
+		let b = word.substring(i, n);
+		let m = b.len();
+		m > 0 then out.insert(i"{a}{b.substring(1, m)}");
+		m > 1 then out.insert(i"{a}{b.substring(1, 2)}{b.substring(0, 1)}{b.substring(2, m)}");
+		mut c = 0usize;
+		for c < letters.len() {
+			let letter = letters.substring(c, c + 1);
+			m > 0 then out.insert(i"{a}{letter}{b.substring(1, m)}");
+			out.insert(i"{a}{letter}{b}");
+			c += 1;
+		}
+		i += 1;
+	}
+	out.remove(word);
+	out
+}
+
+fun gap(a: usize, b: usize): usize {
+	a > b then a - b else b - a
+}
+
+impl WordList {
+	/// The words one edit from `word` (a letter dropped, swapped, changed or
+	/// added), else two, that the list offers; at most `limit`, those keeping
+	/// the word's first letter first.
+	fun near_words(self, word: str, limit: usize): List<str> {
+		let lower = word.to_lowercase();
+		let once = edits(lower).values();
+		mut found = once.filter(|each| self.offered(each));
+		if found.is_empty() && lower.len() <= 12 {
+			mut far: HashSet<str> = HashSet::new();
+			for each in once {
+				for twice in edits(each).values() {
+					self.offered(twice) then far.insert(twice);
+				}
+			}
+			far.remove(lower);
+			found = far.values();
+		}
+		let first = lower.substring(0, 1);
+		let ordered = found.sort_by(|x, y| {
+			let x_rank = x.substring(0, 1) == first then 0usize else 1usize;
+			let y_rank = y.substring(0, 1) == first then 0usize else 1usize;
+			x_rank != y_rank then ret x_rank.compare(y_rank);
+			let x_gap = gap(x.len(), lower.len());
+			let y_gap = gap(y.len(), lower.len());
+			x_gap != y_gap then ret x_gap.compare(y_gap);
+			x.compare(y)
+		});
+		mut out: List<str> = [];
+		for each in ordered {
+			out.len() >= limit then jump break;
+			out.push(each);
+		}
+		out
+	}
+}
+
+impl WordList {
+	/// Up to `limit` words the list offers that start with `prefix` and are
+	/// longer, the shortest first (none with an apostrophe,
+	/// `rec'd`, unless the prefix has one).
+	fun completions_in(self, prefix: str, limit: usize): List<str> {
+		mut lo = 0usize;
+		mut hi = self.sorted.len();
+		for lo < hi {
+			let mid = (lo + hi) / 2;
+			if self.sorted[mid] < prefix {
+				lo = mid + 1;
+			} else {
+				hi = mid;
+			}
+		}
+		let quoted = prefix.contains("'");
+		mut found: List<str> = [];
+		mut at = lo;
+		for at < self.sorted.len() && self.sorted[at].starts_with(prefix) {
+			let each = self.sorted[at];
+			if each.len() > prefix.len() && self.offered(each) && (quoted || !each.contains("'")) {
+				found.push(each);
+			}
+			at += 1;
+		}
+		let ordered = found.sort_by(|a, b| a.len() != b.len()
+			then a.len().compare(b.len())
+			else a.compare(b));
+		mut out: List<str> = [];
+		for each in ordered {
+			out.len() >= limit then jump break;
+			out.push(each);
+		}
+		out
+	}
+}
 
