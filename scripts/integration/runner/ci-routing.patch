     runs-on: ubuntu-latest
     outputs:
       code: ${{ steps.filter.outputs.code }}
+      # TRUSTED: the event's code is this repository's own — a push to a branch
+      # here, or a pull request whose head repository is this one (Dependabot's
+      # branches included). A fork's PR is not, whoever opened it. Only trusted
+      # events may reach the owner's self-hosted runner (the `test` job's
+      # `runs-on`): a self-hosted runner executes whatever the workflow's
+      # checkout holds, so a fork reaching it would be a fork running code on
+      # the owner's machine. The repository setting "require approval for all
+      # outside collaborators" is the second lock; this output is the first and
+      # does not depend on it.
+      trusted: ${{ steps.trust.outputs.trusted }}
     steps:
+      - id: trust
+        run: echo "trusted=${{ github.event_name == 'push' || github.event.pull_request.head.repo.full_name == github.repository }}" >> "$GITHUB_OUTPUT"
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
