enum Shape { Circle(f64), Rect(f64, f64) }
struct Canvas { shape: Shape, note: Option<str> }

fun grow(x: &mut f64) { x = *x * 2.0; }

fun main() {
	mut c = Canvas { shape = Shape::Rect(1.0, 2.0), note = Some("hi") };
	match &mut c.shape {
		Shape::Rect(let w, let h) => { w = 10.0; grow(h); },
		Shape::Circle(let r) => { r = 0.0; },
	}
	match &mut c.note {
		Some(let n) => { n = "there"; },
		None => {},
	}
	print(c.note);
	match c.shape { Shape::Rect(let w, let h) => print(i"{w} {h}"), Shape::Circle(let r) => print(r) }
}
