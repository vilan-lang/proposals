// The spike's pins for places that may not be there (an `Option`'s payload, a
// map's entry) and for the `Optics` derive.
import std::hash_map::HashMap;
import std::io::assert;
import std::reactive::{ Signal, Source, subscriber_of };
import std::shared::Shared;
import pkg::lib::{ Optic, Optics, optic };

[derive(PartialEq, Optics)]
struct Address {
	city: str,
	zip: str,
}

[derive(PartialEq, Optics)]
struct Doc {
	title: Option<str>,
	address: Address,
	scores: HashMap<str, i32>,
}

/// Counts wakes without reading the value: `on_change` reads it, and a place
/// that is gone has none to give (FINDINGS.md, partial places).
fun count<T, S: Source<T>>(source: S): Shared<i32> {
	let seen = Shared::new(0);
	let _watch = source.on_settle(subscriber_of(|| seen.write() += 1, false));
	seen
}

fun main() {
	mut scores: HashMap<str, i32> = HashMap::new();
	scores.insert("ada", 1);
	let doc = optic(Doc {
		title = None,
		address = Address { city = "London", zip = "N1" },
		scores,
	});

	// The derive: accessors by field name, composed.
	let city = doc.address().city();
	let cities = count(city);
	city.set("Paris");
	assert(doc.get().address.city == "Paris", "a derived accessor writes through");
	assert(cities.read() == 1, "and wakes its watcher");

	// An Option's payload.
	let title = doc.title();
	let text = title.some();
	let texts = count(text);
	assert(text.peek(|t| *t) == None, "an absent payload reads None");
	assert(!text.try_set("x"), "and refuses a write");
	title.set(Some("Hello"));
	assert(texts.read() == 1, "appearing wakes");
	assert(text.get() == "Hello", "a present payload reads");
	assert(text.try_set("Hi"), "and takes a write");
	assert(title.get() == Some("Hi"), "which lands in the option");
	assert(texts.read() == 2, "and wakes");
	title.set(None);
	assert(texts.read() == 3, "disappearing wakes");
	title.set(None);
	assert(texts.read() == 3, "absent to absent does not");
	city.set("Rome");
	assert(texts.read() == 3, "nor does a write elsewhere");

	// A map's entry.
	let ada = doc.scores().entry("ada");
	let bob = doc.scores().entry("bob");
	let adas = count(ada);
	let bobs = count(bob);
	assert(ada.get() == 1, "an entry reads");
	ada.set(2);
	assert(doc.get().scores.get("ada") == Some(2), "an entry writes in place");
	assert(adas.read() == 1, "its watcher woke");
	assert(bobs.read() == 0, "another key's slept");
	assert(bob.peek(|v| *v) == None, "a missing key reads None");
	doc.scores().update(|map| map.insert("bob", 7));
	assert(bob.get() == 7, "a key that appears reads");
	assert(bobs.read() == 1, "and woke");
	assert(adas.read() == 1, "the unchanged key slept");

	print("optic spike: partial places hold");
}
