import pkg::lib::{ Optic, Optics, optic };
import std::reactive::{ Disposable, Signal, SignalCell, Source, comp };

[derive(PartialEq, Optics)]
struct P {
	name: str,
}

fun main() {
	let (_x, owner) = comp(|| { let user = optic(P { name = "a" }); let name = user.name(); let m = name.derive(|n| i"{n}!").memo(); name.set("b"); print(m.get()); }); owner.dispose();
}
